{
	"name": "C++",
	"build": {
		"dockerfile": "Dockerfile"
	},
	"customizations": {
		"vscode": {
			"settings": {},
			"extensions": [
				"streetsidesoftware.code-spell-checker",
				"ms-vscode.cpptools",
				"ms-vscode.cmake-tools",
				"twxs.cmake",
				"ms-vscode.cpptools-extension-pack",
				"eamodio.gitlens",
				"ms-vscode-remote.remote-containers",
				"ms-azuretools.vscode-docker"
			]
		}
	},
	"forwardPorts": [
		8080
	],
	// Start Xvfb before running the container
	"initializeCommand": "Xvfb :99 -screen 0 1024x768x24 &",
	"containerEnv": {
		"DISPLAY": ":99"
	},
	// Use the start-xvfb wrapper script
	"entryPoint": "/usr/local/bin/start-xvfb"
}