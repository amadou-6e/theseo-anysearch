{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AnySearch",
  "version": "0.1.0",
  "identifier": "com.theseo.anysearch",
  "build": {
    "beforeDevCommand": "npm run dev --prefix web",
    "beforeBuildCommand": "npm run build --prefix web",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "AnySearch",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
